---
import { getScriptClass } from '../utils/language-map';

export interface Props {
  available: { key: string; label: string; language: string }[];
  current: string;   // the currently active language key
  slug: string;      // poem slug
  compareMode?: boolean;  // whether we're in compare view
  compareSide?: 'left' | 'right';  // which side of the comparison
  compareOtherLang?: string;  // the language on the other side
  sourceUrl?: string;  // GitHub source link
  webUrl?: string;     // version-specific source URL
  isbnUrl?: string;    // version-specific ISBN link
}

const { available, current, slug, compareMode = false, compareSide, compareOtherLang, sourceUrl, webUrl, isbnUrl } = Astro.props;

// Build the href based on mode
const buildHref = (langKey: string) => {
  if (compareMode && compareSide && compareOtherLang) {
    if (compareSide === 'left') {
      return `/poems/${slug}/compare/${langKey}+${compareOtherLang}`;
    } else {
      return `/poems/${slug}/compare/${compareOtherLang}+${langKey}`;
    }
  }
  return `/poems/${slug}/${langKey}`;
};
---

<nav class="lang-switcher" aria-label="Language selector">
  {available.map(({ key, label, language }) => (
    <a
      href={buildHref(key)}
      class:list={['lang-tab', { active: key === current }]}
      lang={language}
      data-script={getScriptClass(language)}
    >
      {label}
    </a>
  ))}
  {(isbnUrl || webUrl || sourceUrl) && (
    <span class="source-icons">
      {isbnUrl && (
        <a href={isbnUrl} class="source-link" target="_blank" rel="noopener noreferrer" title="View on Open Library">
          <img src="/isbn.svg" alt="ISBN" width="16" height="16" />
        </a>
      )}
      {webUrl && (
        <a href={webUrl} class="source-link" target="_blank" rel="noopener noreferrer" title="View source">
          <img src="/web.svg" alt="Web" width="16" height="16" />
        </a>
      )}
      {sourceUrl && (
        <a href={sourceUrl} class="source-link" target="_blank" rel="noopener noreferrer" title="View source on GitHub">
          <img src="/git.svg" alt="Git" width="16" height="16" />
        </a>
      )}
    </span>
  )}
</nav>

<style>
  .lang-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid #dcd5c6;
    padding-bottom: 0.4rem;
  }

  .lang-tab {
    padding: 0.3rem 0.8rem;
    text-decoration: none;
    color: #555;
    font-size: 0.9rem;
    border-radius: 4px 4px 0 0;
    transition: background 0.2s;
  }

  .lang-tab:hover {
    background: #ece6d9;
    color: #1a1a1a;
  }

  .lang-tab.active {
    background: #fdfaf3;
    color: #1a1a1a;
    font-weight: bold;
    border: 1px solid #dcd5c6;
    border-bottom-color: transparent;
  }

  .source-icons {
    margin-left: auto;
    display: flex;
    align-items: center;
  }

  .source-link {
    display: flex;
    align-items: center;
    padding: 0.3rem 0.5rem;
    opacity: 0.4;
    transition: opacity 0.15s;
  }

  .source-link:hover {
    opacity: 0.8;
  }

  .source-link img {
    filter: grayscale(100%);
    width: 16px;
    height: 16px;
  }
</style>
