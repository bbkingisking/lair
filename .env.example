# Where the poems come from. Either is enough:
#
#   POETRY_REPO_PATH  a checkout already on this machine; no clone, no network,
#                     and the build does not depend on a forge being reachable.
#                     Point it at the repo ROOT, not the collection/ subdirectory,
#                     so source-map paths keep the prefix the browse URL needs.
#   POETRY_REPO_URL   clone this instead, into .poetry-repo/
#
POETRY_REPO_PATH=/home/whitman/literature/poetry
POETRY_REPO_URL=https://github.com/bbkingisking/poetry.git

# Public browse URL the per-poem "view source" links point at. Required when
# reading from a local path, and when the checkout's remote is a host whose file
# URLs are not GitHub-shaped (Gitea uses /src/branch/, not /blob/) or is only
# reachable on the LAN.
POETRY_BLOB_BASE=https://github.com/bbkingisking/poetry/blob/main
