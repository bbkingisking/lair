---
import PoemDisplayHorizontal from './PoemDisplayHorizontal.astro';
import PoemDisplayVertical from './PoemDisplayVertical.astro';

export interface Props {
  title?: string;
  author?: string;
  authorSlug?: string;
  translator?: string;
  language: string;
  text: string;
  rtl?: boolean;
  vertical?: boolean;
}

const { title, author, authorSlug, translator, language, text, rtl = false, vertical = false } = Astro.props;
---

{vertical ? (
  <PoemDisplayVertical
    title={title}
    author={author}
    authorSlug={authorSlug}
    translator={translator}
    language={language}
    text={text}
  />
) : (
  <PoemDisplayHorizontal
    title={title}
    author={author}
    authorSlug={authorSlug}
    translator={translator}
    language={language}
    text={text}
    rtl={rtl}
  />
)}