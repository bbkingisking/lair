---
export interface Props {
  title: string;
  language?: string;
  scriptClass?: string;
  dir?: 'ltr' | 'rtl';
}

const { title, language = 'en', scriptClass = 'script-latin', dir = 'ltr' } = Astro.props;
---

<!DOCTYPE html>
<html lang={language} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <style is:global>
    /* Latin — English, Bulgarian, etc. */
    @font-face {
      font-family: 'IMFellEnglish';
      src: url('/fonts/IMFellEnglish-Regular.woff2') format('woff2');
      font-weight: normal;
      font-style: normal;
    }
    @font-face {
      font-family: 'IMFellEnglish';
      src: url('/fonts/IMFellEnglish-Italic.woff2') format('woff2');
      font-weight: normal;
      font-style: italic;
    }

    /* Latin text face — for body copy alongside Fell */
    @font-face {
      font-family: 'Marxiana';
      src: url('/fonts/TT Marxiana Trial Antiqua.woff2') format('woff2');
      font-weight: normal;
      font-style: normal;
    }

    @font-face {
      font-family: 'Marxiana';
      src: url('/fonts/TT Marxiana Trial Antiqua Italic.woff2') format('woff2');
      font-weight: normal;
      font-style: italic;
    }

    /* Chinese — Simplified (SC) */
    @font-face {
      font-family: 'NotoSerifSC';
      src: url('/fonts/NotoSerifSC-VariableFont_wght.woff2') format('woff2');
      font-weight: 100 900;
      font-style: normal;
    }

    /* Chinese — Traditional (TC) */
    @font-face {
      font-family: 'NotoSerifTC';
      src: url('/fonts/NotoSerifTC-VariableFont_wght.woff2') format('woff2');
      font-weight: 100 900;
      font-style: normal;
    }

    /* Korean */
    @font-face {
      font-family: 'AGChoiJeongHo';
      src: url('/fonts/AGChoiJeongHoStd.woff2') format('woff2');
      font-weight: normal;
      font-style: normal;
    }
    .script-latin   { font-family: 'IMFellEnglish', serif; }
    .script-cyrillic { font-family: 'Marxiana', serif; }
    .script-hans    { font-family: 'NotoSerifSC', serif; }
    .script-hant    { font-family: 'NotoSerifTC', serif; }
    .script-hangul  { font-family: 'AGChoiJeongHo', serif; }
    .script-arabic  { font-family: serif; }
    .script-japanese { font-family: serif; }

    body {
      margin: 0;
      padding: 2rem;
      background: #fdfaf3;
      color: #1a1a1a;
      line-height: 1.8;
    }

    pre {
      font-family: inherit;
      white-space: pre-wrap;
      margin: 0;
      tab-size: 4;
    }
  </style>
</head>
<body class={scriptClass}>
  <slot />
</body>
</html>
