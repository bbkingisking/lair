---
import LairLayout from '../layouts/LairLayout.astro';

// `[lang].astro` and `compare/[langs].astro` both redirect here for a version
// that does not exist. The host serves this for unknown paths too — on Bunny,
// via the storage zone's 404 file path, with the status left at 404.
---

<LairLayout title="Not in the collection — The dragon's lair" search>
  <div class="notfound">
    <p class="code">404</p>
    <p class="message">This page is not in the collection.</p>
    <p class="links">
      <a href="/">Authors</a>
      <span class="sep">·</span>
      <a href="/title">Titles</a>
      <span class="sep">·</span>
      <a href="/language">Languages</a>
    </p>
  </div>
</LairLayout>

<style>
  .notfound {
    text-align: center;
    padding: 4rem 1rem 5rem;
  }

  .code {
    font-family: 'IM Fell English', serif;
    font-size: clamp(3.5rem, 10vw, 6rem);
    line-height: 1;
    color: var(--rust);
    opacity: 0.85;
  }

  .message {
    font-family: 'IM Fell English', serif;
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ink-light);
    margin-top: 1rem;
  }

  .links {
    margin-top: 2.5rem;
    font-family: 'Inconsolata', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .links a {
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.15s;
  }

  .links a:hover {
    color: var(--rust);
  }

  .sep {
    color: var(--border);
    margin: 0 0.6rem;
  }
</style>
