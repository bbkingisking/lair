---
export interface Props {
  title?: string;
  author?: string;
  authorSlug?: string;
  translator?: string;
  language: string;
  text: string;
}

const { title, author, authorSlug, translator, language, text } = Astro.props;

// Build header as HTML string for embedding in <pre>
function escapeHtml(s: string) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

const headerParts: string[] = [];
if (title) headerParts.push(escapeHtml(title));
if (author) {
  headerParts.push(authorSlug
    ? `<a class="poem-author-link" href="/author/${authorSlug}">${escapeHtml(author)}</a>`
    : escapeHtml(author)
  );
}
if (translator) headerParts.push(`translated by ${escapeHtml(translator)}`);
const headerHtml = headerParts.length ? headerParts.join('　') + '\n' : '';
---

<article class="poem" lang={language}>
  <div class="scroll">
    {headerHtml && <pre class="header" set:html={headerHtml.trimEnd()} />}
    <pre class="text" set:html={escapeHtml(text)} />
  </div>
</article>

<style>
  .poem {
    max-width: none;
    display: flex;
    justify-content: right;
  }

  .scroll {
    display: flex;
    flex-direction: column;
    writing-mode: vertical-rl;
    max-inline-size: 40vh;
    overflow-x: auto;
  }

  .header {
    font-family: inherit;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    white-space: pre-wrap;
    line-height: 1.8;
    padding: 0 0.5rem 2 0;
    text-align: left;
    font-size: 1.5rem;
    border-left: 1px solid var(--border);
    color: var(--ink-light);
  }

  .text {
    font-family: inherit;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    white-space: pre-wrap;
    line-height: 1.8;
    padding: 0 0.5rem;
    text-align: left;
    font-size: 1.5rem;
  }

  .header :global(.poem-author-link) {
    color: inherit;
    text-decoration: none;
  }

  .header :global(.poem-author-link:visited) {
    color: inherit;
  }
</style>
