---
import { getCollection } from 'astro:content';
import LairLayout from '../../../../layouts/LairLayout.astro';
import PoemDisplay from '../../../../components/PoemDisplay.astro';
import LanguageSwitcher from '../../../../components/LanguageSwitcher.astro';
import { getScriptClass } from '../../../../utils/language-map';
import { authorToSlug } from '../../../../utils/author-slug';
import { versionTitle } from '../../../../utils/poem-title';

export async function getStaticPaths() {
  const poems = await getCollection('poems');
  const paths = [];
  
  for (const poem of poems) {
    const langKeys = Object.keys(poem.data).filter(key => poem.data[key]?.text);
    
    // Every ordered pair of two *different* versions. A version compared against
    // itself renders the same text twice, so those routes are not generated.
    for (let i = 0; i < langKeys.length; i++) {
      for (let j = 0; j < langKeys.length; j++) {
        if (i === j) continue;
        paths.push({
          params: { 
            slug: poem.id, 
            langs: `${langKeys[i]}+${langKeys[j]}` 
          },
          props: { poem, lang1: langKeys[i], lang2: langKeys[j] },
        });
      }
    }
  }
  
  return paths;
}

const { poem, lang1, lang2 } = Astro.props;
const version1 = poem.data[lang1];
const version2 = poem.data[lang2];
const sourceUrl = poem.data.sourceUrl as string | undefined;

// Version-specific links
function isValidUrl(str: string): boolean {
  try { new URL(str); return true; } catch { return false; }
}

const webUrl1 = version1.source && isValidUrl(version1.source) ? version1.source : undefined;
const isbnUrl1 = version1.isbn ? `https://openlibrary.org/isbn/${version1.isbn}` : undefined;
const webUrl2 = version2.source && isValidUrl(version2.source) ? version2.source : undefined;
const isbnUrl2 = version2.isbn ? `https://openlibrary.org/isbn/${version2.isbn}` : undefined;

if (!version1 || !version1.text || !version2 || !version2.text) {
  return Astro.redirect('/404');
}

const canonical = poem.data.canonical;
const language1 = version1.language || 'en';
const language2 = version2.language || 'en';
const scriptClass = getScriptClass(language1);
const authorSlug = canonical.author ? authorToSlug(canonical.author) : undefined;

const isRtl1 = version1.rtl === true;
const isVertical1 = version1.vertical === true;
const isRtl2 = version2.rtl === true;
const isVertical2 = version2.vertical === true;

const LANG_NAMES: Record<string, string> = {
  eng: 'English',
  en: 'English',
  bul: 'Bulgarian',
  fra: 'French',
  jpn: 'Japanese',
  lzh: 'Classical Chinese',
  kor: 'Korean',
  rus: 'Russian',
  fas: 'Persian',
  okm: 'Middle Korean',
  'zho-Hans': 'Chinese',
  deu: 'German',
  ita: 'Italian'
};

const formatVersionLabel = (key: string, lang?: string) => {
  const labels: Record<string, string> = {
    canonical: 'Translation',
    original: 'Original',
    lzh: 'Classical Chinese',
    lzh_formatted: 'Classical Chinese (formatted)',
    korean: 'Korean',
    modern_korean: 'Modern Korean',
    middle_korean: 'Middle Korean',
    modern_chinese: 'Modern Chinese',
    hanja_eum: 'Hanja Reading',
    translation: 'Alt. Translation'
  };
  if (key === 'canonical' && lang) {
    return LANG_NAMES[lang] || lang.toUpperCase();
  }
  return labels[key] || key;
};

const available = Object.entries(poem.data)
  .filter(([_, v]) => v && v.text)
  .map(([key, v]) => ({
    key,
    label: formatVersionLabel(key, v.language),
    language: v.language || 'en',
  }));
---

<LairLayout title={`${versionTitle(version1)} — Compare`} {scriptClass}>
  <div class="compare-container">
    <div class="poem-panel" dir={isRtl1 && !isVertical1 ? 'rtl' : 'ltr'}>
      <LanguageSwitcher
        available={available}
        current={lang1}
        slug={poem.id}
        compareMode={true}
        compareSide="left"
        compareOtherLang={lang2}
        webUrl={webUrl1}
        isbnUrl={isbnUrl1}
      />
      <PoemDisplay
        title={version1.title}
        author={version1.author}
        authorSlug={authorSlug}
        translator={version1.translator}
        language={language1}
        text={version1.text}
        rtl={isRtl1}
        vertical={isVertical1}
      />
    </div>
    
    <div class="poem-panel" dir={isRtl2 && !isVertical2 ? 'rtl' : 'ltr'}>
      <LanguageSwitcher
        available={available}
        current={lang2}
        slug={poem.id}
        compareMode={true}
        compareSide="right"
        compareOtherLang={lang1}
        sourceUrl={sourceUrl}
        webUrl={webUrl2}
        isbnUrl={isbnUrl2}
        compareToggle={true}
      />
      <PoemDisplay
        title={version2.title}
        author={version2.author}
        authorSlug={authorSlug}
        translator={version2.translator}
        language={language2}
        text={version2.text}
        rtl={isRtl2}
        vertical={isVertical2}
      />
    </div>
  </div>
</LairLayout>

<style>
  .compare-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 100%;
  }
  
  .poem-panel {
    min-width: 0;
    overflow-x: auto;
  }
  
  @media (max-width: 768px) {
    .compare-container {
      grid-template-columns: 1fr;
    }
  }
</style>