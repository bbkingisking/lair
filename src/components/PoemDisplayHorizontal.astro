---
export interface Props {
  title?: string;
  author?: string;
  translator?: string;
  language: string;
  text: string;
  rtl?: boolean;
}

const { title, author, translator, language, text, rtl = false } = Astro.props;
---

<article
  class="poem-display"
  lang={language}
  dir={rtl ? 'rtl' : undefined}
  transition:name="poem"
>
  {title && <h1 class="poem-title">{title}</h1>}
  {author && <p class="poem-author">{author}</p>}
  <hr class="poem-divider" />
  <pre class="poem-text">{text}</pre>
  {translator && (
    <hr class="poem-divider" />
    <p class="poem-translator">translated by: {translator}</p>
  )}
</article>
