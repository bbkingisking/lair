---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getScriptClass } from '../../utils/language-map';

export async function getStaticPaths() {
  const poems = await getCollection('poems');
  return poems.map(poem => ({
    params: { slug: poem.id },
    props: { poem },
  }));
}

const { poem } = Astro.props;
const canonical = poem.data.canonical;
---

<Base
  title={canonical.title || 'Untitled'}
  language={canonical.language || 'en'}
  scriptClass={getScriptClass(canonical.language || 'en')}
>
  <pre>{canonical.text}</pre>
</Base>
