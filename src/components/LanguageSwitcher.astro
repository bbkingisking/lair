---
import { getScriptClass } from '../utils/language-map';

export interface Props {
  available: { key: string; label: string; language: string }[];
  current: string;   // the currently active language key
  slug: string;      // poem slug
  compareMode?: boolean;  // whether we're in compare view
  compareSide?: 'left' | 'right';  // which side of the comparison
  compareOtherLang?: string;  // the language on the other side
  sourceUrl?: string;  // GitHub source link
  webUrl?: string;     // version-specific source URL
  isbnUrl?: string;    // version-specific ISBN link
  compareToggle?: boolean;  // show side-by-side toggle in source icons
}

const { available, current, slug, compareMode = false, compareSide, compareOtherLang, sourceUrl, webUrl, isbnUrl, compareToggle = false } = Astro.props;

// Build the href based on mode
const buildHref = (langKey: string) => {
  if (compareMode && compareSide && compareOtherLang) {
    // Picking the version already shown opposite swaps the two panels. Placing
    // it on this side as-is would ask for a version compared against itself,
    // which is not a route.
    if (langKey === compareOtherLang) {
      return compareSide === 'left'
        ? `/poems/${slug}/compare/${langKey}+${current}`
        : `/poems/${slug}/compare/${current}+${langKey}`;
    }
    if (compareSide === 'left') {
      return `/poems/${slug}/compare/${langKey}+${compareOtherLang}`;
    } else {
      return `/poems/${slug}/compare/${compareOtherLang}+${langKey}`;
    }
  }
  return `/poems/${slug}/${langKey}`;
};
---

<nav class="lang-switcher" aria-label="Language selector">
  {available.map(({ key, label, language }) => (
    <a
      href={buildHref(key)}
      class:list={['lang-tab', { active: key === current }]}
      lang={language}
      data-script={getScriptClass(language)}
    >
      {label}
    </a>
  ))}
  {(isbnUrl || webUrl || sourceUrl || compareToggle) && (
    <span class="source-icons">
      {compareToggle && (
        <a href={`/poems/${slug}/${current}`} class="source-link" title="Single view">
          <img src="/side-by-side.svg" alt="Single view" width="16" height="16" />
        </a>
      )}
      {isbnUrl && (
        <a href={isbnUrl} class="source-link" target="_blank" rel="noopener noreferrer" title="View on Open Library">
          <img src="/isbn.svg" alt="ISBN" width="16" height="16" />
        </a>
      )}
      {webUrl && (
        <a href={webUrl} class="source-link" target="_blank" rel="noopener noreferrer" title="View source">
          <img src="/web.svg" alt="Web" width="16" height="16" />
        </a>
      )}
      {sourceUrl && (
        <a href={sourceUrl} class="source-link" target="_blank" rel="noopener noreferrer" title="View source on GitHub">
          <img src="/git.svg" alt="Git" width="16" height="16" />
        </a>
      )}
    </span>
  )}
</nav>

<style>
  .lang-switcher {
    display: flex;
    gap: 0;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--border);
    flex-wrap: wrap;
  }

  .lang-tab {
    padding: 0.5rem 1rem;
    font-family: 'Inconsolata', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
    background: none;
    color: var(--ink-faint);
    text-decoration: none;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: all 0.15s;
  }

  .lang-tab:hover {
    color: var(--ink);
  }

  .lang-tab.active {
    color: var(--rust);
    border-bottom-color: var(--rust);
  }

  .source-icons {
    margin-left: auto;
    display: flex;
    align-items: center;
  }

  .source-link {
    display: flex;
    align-items: center;
    padding: 0.3rem 0.5rem;
    opacity: 0.4;
    transition: opacity 0.15s;
  }

  .source-link:hover {
    opacity: 0.8;
  }

  .source-link img {
    filter: grayscale(100%);
    width: 16px;
    height: 16px;
  }
</style>
