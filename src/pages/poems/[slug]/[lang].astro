---
import { getCollection } from 'astro:content';
import LairLayout from '../../../layouts/LairLayout.astro';
import { getScriptClass } from '../../../utils/language-map';
import { authorToSlug } from '../../../utils/author-slug';
import PoemDisplay from '../../../components/PoemDisplay.astro';
import VersionTabs from '../../../components/VersionTabs.astro';
import { versionTitle, attributedTitle } from '../../../utils/poem-title';
import { excerpt } from '../../../utils/poem-excerpt';

export async function getStaticPaths() {
  const poems = await getCollection('poems');
  const paths = [];
  for (const poem of poems) {
    for (const [langKey, val] of Object.entries(poem.data)) {
      if (val && typeof val === 'object' && val.text) {
        paths.push({
          params: { slug: poem.id, lang: langKey },
          props: { poem, langKey },
        });
      }
    }
  }
  return paths;
}

const { poem, langKey } = Astro.props;
const version = poem.data[langKey];

if (!version || !version.text) {
  return Astro.redirect('/404');
}

const canonical = poem.data.canonical;
const language = version.language || 'en';
const scriptClass = getScriptClass(language);
const isRtl = version.rtl === true;
const isVertical = version.vertical === true;
const isDrama = version.drama === true;
const authorSlug = canonical.author ? authorToSlug(canonical.author) : undefined;

const sourceUrl = poem.data.sourceUrl as string | undefined;

// Version-specific links
const versionSource = version.source as string | undefined;
const versionIsbn = version.isbn as string | undefined;

function isValidUrl(str: string): boolean {
  try { new URL(str); return true; } catch { return false; }
}

const webUrl = versionSource && isValidUrl(versionSource) ? versionSource : undefined;
const isbnUrl = versionIsbn ? `https://openlibrary.org/isbn/${versionIsbn}` : undefined;

const available = Object.entries(poem.data)
  .filter(([_, v]) => v && typeof v === 'object' && v.text)
  .map(([key, v]) => ({
    key,
    label: (v as any).title || key,
    language: (v as any).language || 'en',
  }));

const otherLang = available.find(a => a.key !== langKey)?.key;
const compareUrl = otherLang ? `/poems/${poem.id}/compare/${langKey}+${otherLang}` : undefined;

const LANG_NAMES: Record<string, string> = {
  eng: 'English',
  en: 'English',
  bul: 'Bulgarian',
  fra: 'French',
  jpn: 'Japanese',
  lzh: 'Classical Chinese',
  kor: 'Korean',
  rus: 'Russian',
  fas: 'Persian',
  okm: 'Middle Korean',
  'zho-Hans': 'Chinese',
  deu: 'German',
  ita: 'Italian'
};

const formatVersionLabel = (key: string, lang?: string) => {
  const labels: Record<string, string> = {
    canonical: 'Translation',
    original: 'Original',
    lzh: 'Classical Chinese',
    lzh_formatted: 'Classical Chinese (formatted)',
    korean: 'Korean',
    modern_korean: 'Modern Korean',
    middle_korean: 'Middle Korean',
    modern_chinese: 'Modern Chinese',
    hanja_eum: 'Hanja Reading',
    translation: 'Alt. Translation'
  };
  
  if (key === 'canonical' && lang) {
    return LANG_NAMES[lang] || lang.toUpperCase();
  }
  
  return labels[key] || key;
};
---

<LairLayout
  title={versionTitle(version)}
  previewTitle={attributedTitle(version, canonical.author)}
  description={excerpt(version.text)}
  preview
  {scriptClass}
>
  <style>
    /* Specific enough to beat `.source-link`'s display whatever the source
       order, rather than relying on sitting after it. */
    @media (max-width: 768px) {
      .source-link.compare-toggle {
        display: none;
      }
    }

    .source-icons {
      display: flex;
      align-items: center;
    }

    .source-link {
      display: flex;
      align-items: center;
      padding: 0.5rem 0.75rem;
      opacity: 0.4;
      transition: opacity 0.15s;
    }

    .source-link:hover {
      opacity: 0.8;
    }

    .source-link img {
      filter: grayscale(100%);
      width: 16px;
      height: 16px;
    }
  </style>

  <VersionTabs
    label="Version selector"
    tabs={available.map(({ key, language: versionLang }) => ({
      href: `/poems/${poem.id}/${key}`,
      label: formatVersionLabel(key, versionLang),
      language: versionLang,
      active: key === langKey,
    }))}
  >
    {(compareUrl || isbnUrl || webUrl || sourceUrl) && (
      <span class="source-icons">
        {compareUrl && (
          <a href={compareUrl} class="source-link compare-toggle" title="Side by side">
            <img src="/side-by-side.svg" alt="Side by side" width="16" height="16" />
          </a>
        )}
        {isbnUrl && (
          <a href={isbnUrl} class="source-link" target="_blank" rel="noopener noreferrer" title="View on Open Library">
            <img src="/isbn.svg" alt="ISBN" width="16" height="16" />
          </a>
        )}
        {webUrl && (
          <a href={webUrl} class="source-link" target="_blank" rel="noopener noreferrer" title="View source">
            <img src="/web.svg" alt="Web" width="16" height="16" />
          </a>
        )}
        {sourceUrl && (
          <a href={sourceUrl} class="source-link" target="_blank" rel="noopener noreferrer" title="View source on GitHub">
            <img src="/git.svg" alt="Git" width="16" height="16" />
          </a>
        )}
      </span>
    )}
  </VersionTabs>

  <PoemDisplay
    title={version.title}
    author={version.author}
    authorSlug={authorSlug}
    translator={version.translator}
    language={language}
    text={version.text}
    rtl={isRtl}
    vertical={isVertical}
    drama={isDrama}
  />
</LairLayout>