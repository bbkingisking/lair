---
export interface Props {
  title: string;
  language?: string;
  scriptClass?: string;
}

const { title, language = 'en', scriptClass = 'script-latin' } = Astro.props;
---

<!DOCTYPE html>
<html lang={language}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <style is:global>
    /* Latin — English, Bulgarian, etc. */
    @font-face {
      font-family: 'IMFellEnglish';
      src: url('/fonts/IMFellEnglish-Regular.ttf') format('truetype');
      font-weight: normal;
      font-style: normal;
    }
    @font-face {
      font-family: 'IMFellEnglish';
      src: url('/fonts/IMFellEnglish-Italic.ttf') format('truetype');
      font-weight: normal;
      font-style: italic;
    }

    /* Latin text face — for body copy alongside Fell */
    @font-face {
      font-family: 'Marxiana';
      src: url('/fonts/TT Marxiana Trial Antiqua.ttf') format('truetype');
      font-weight: normal;
      font-style: normal;
    }

    @font-face {
      font-family: 'Marxiana';
      src: url('/fonts/TT Marxiana Trial Antiqua Italic.ttf') format('truetype');
      font-weight: normal;
      font-style: italic;
    }

    /* Classical Chinese */
    @font-face {
      font-family: 'ZhuqueFangsong';
      src: url('/fonts/ZhuqueFangsong-Regular.ttf') format('truetype');
      font-weight: normal;
      font-style: normal;
    }

    /* Korean */
    @font-face {
      font-family: 'AGChoiJeongHo';
      src: url('/fonts/AGChoiJeongHoStd.otf') format('opentype');
      font-weight: normal;
      font-style: normal;
    }
    .script-latin   { font-family: 'IMFellEnglish', serif; }
    .script-cyrillic { font-family: 'Marxiana', serif; }
    .script-hanzi   { font-family: 'ZhuqueFangsong', serif; }
    .script-hangul  { font-family: 'AGChoiJeongHo', serif; }
    .script-arabic  { font-family: serif; }
    .script-japanese { font-family: serif; }

    body {
      margin: 0;
      padding: 2rem;
      background: #fdfaf3;
      color: #1a1a1a;
      line-height: 1.8;
    }

    pre {
      font-family: inherit;
      white-space: pre-wrap;
      margin: 0;
      tab-size: 4;
    }
  </style>
</head>
<body class={scriptClass}>
  <slot />
</body>
</html>
