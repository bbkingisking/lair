---
import { getCollection } from 'astro:content';
import LairLayout from '../layouts/LairLayout.astro';
import { getScriptClass } from '../utils/language-map';

const allPoems = await getCollection('poems');

// Helper to get title from a poem
const getTitle = (poem: any) => {
  return poem.data.canonical?.title || 'Untitled';
};

// Helper to get author from a poem
const getAuthor = (poem: any) => {
  return poem.data.canonical?.author || 'Unknown';
};

// Helper to get language from a poem
const getLanguage = (poem: any) => {
  return poem.data.canonical?.language || 'en';
};

// Get all poems sorted by title
const poemsByTitle = [...allPoems].sort((a, b) => {
  return getTitle(a).localeCompare(getTitle(b));
});

const searchIndex = allPoems
  .filter(p => p.data.canonical?.text)
  .map(p => ({ title: getTitle(p), author: getAuthor(p), slug: p.id, lang: 'canonical' }));
---

<LairLayout title="The dragon's lair" showSidebar={false} searchIndex={searchIndex}>
  <style>
    .index-container {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    /* TABBED BOX */
    .tabbed-box {
      width: 100%;
      background: var(--warm-white);
      border: 1px solid var(--border);
      border-radius: 4px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      max-height: 95vh;
    }

    .tab-navbar {
      display: flex;
      border-bottom: 1px solid var(--border);
      background: var(--paper);
      flex-shrink: 0;
    }

    .tab-button {
      flex: 1;
      padding: 1rem 1.5rem;
      border: none;
      background: none;
      font-family: 'Inconsolata', monospace;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--ink-light);
      transition: all 0.2s;
      border-bottom: 3px solid transparent;
      position: relative;
      text-decoration: none;
      display: block;
      text-align: center;
    }

    .tab-button:hover {
      color: var(--ink);
      background: var(--warm-white);
    }

    .tab-button.active {
      color: var(--rust);
      background: var(--warm-white);
      border-bottom-color: var(--rust);
      font-weight: 600;
    }

    .tab-content {
      padding: 2rem;
      overflow-y: auto;
      flex: 1;
      min-height: 0;
    }

    /* POEMS LIST */
    .poems-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .poem-entry {
      text-decoration: none;
      color: var(--ink);
      display: block;
      padding: 0 0 1.5rem 0;
      border-bottom: 1px solid var(--paper-dark);
      transition: all 0.2s;
    }

    .poem-entry:last-child {
      border-bottom: none;
    }

    .poem-entry:hover .poem-title {
      color: var(--rust);
    }

    .poem-title {
      font-family: 'IM Fell English', serif;
      font-size: 1.3rem;
      font-weight: 400;
      margin-bottom: 0.3rem;
      color: var(--ink);
      line-height: 1.3;
      transition: color 0.2s;
    }

    .poem-meta {
      font-size: 0.8rem;
      font-style: italic;
      color: var(--ink-light);
    }

    @media (max-width: 768px) {
      .tab-navbar {
        flex-direction: column;
      }

      .tab-button {
        border-bottom: 1px solid var(--paper-dark);
        border-left: 3px solid transparent;
      }

      .tab-button.active {
        border-bottom-color: var(--paper-dark);
        border-left-color: var(--rust);
      }

      .tab-content {
        padding: 1.5rem;
      }

      .tabbed-box {
        max-height: 90vh;
      }
    }
  </style>

  <div class="index-container">
    <div class="tabbed-box">
      <nav class="tab-navbar">
        <a href="/" class="tab-button">By Author</a>
        <a href="/title" class="tab-button active">By Title</a>
        <a href="/language" class="tab-button">By Language</a>
      </nav>

      <div class="tab-content">
        <div class="poems-list">
          {poemsByTitle.map(poem => {
            const lang = getLanguage(poem);
            const scriptClass = getScriptClass(lang);
            return (
              <a href={`/poems/${poem.id}/canonical`} class="poem-entry">
                <div class:list={['poem-title', scriptClass]} lang={lang}>{getTitle(poem)}</div>
                <div class="poem-meta">{getAuthor(poem)}</div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</LairLayout>