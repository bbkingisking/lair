---
import { getCollection } from 'astro:content';
import LairLayout from '../../layouts/LairLayout.astro';
import { getScriptClass } from '../../utils/language-map';
import { iso6393 } from 'iso-639-3';
import { versionTitle } from '../../utils/poem-title';

export async function getStaticPaths() {
  // Normalize language code: split by '-' and take first part
  function normalizeLanguageCode(lang: string): string {
    return lang.split('-')[0];
  }

  const allPoems = await getCollection('poems');
  
  // Get unique languages from ALL versions
  const languageGroups = allPoems.reduce((acc: any, poem) => {
    const allVersions = Object.keys(poem.data);
    
    allVersions.forEach(versionKey => {
      const version = poem.data[versionKey];
      if (version && typeof version === 'object' && 'text' in version) {
        const lang = version.language || versionKey;
        const normalizedLang = normalizeLanguageCode(lang);
        if (!acc[normalizedLang]) {
          acc[normalizedLang] = [];
        }
        if (!acc[normalizedLang].some((p: any) => p.id === poem.id)) {
          acc[normalizedLang].push(poem);
        }
      }
    });
    
    return acc;
  }, {});

  return Object.keys(languageGroups).map(lang => ({
    params: { language: lang },
    props: { poems: languageGroups[lang], languageCode: lang }
  }));
}

// Get language name from ISO 639-3 code
function getLanguageName(code: string): string {
  const normalized = code.split('-')[0];
  const lang = iso6393.find((l: any) => l.iso6393 === normalized);
  return lang?.name || code;
}

const { poems, languageCode } = Astro.props;

const allPoemsForSearch = await getCollection('poems');
const searchIndex = allPoemsForSearch
  .filter(p => p.data.canonical?.text)
  .map(p => ({ title: versionTitle(p.data.canonical), author: p.data.canonical?.author || 'Unknown', slug: p.id, lang: 'canonical' }));
const languageName = getLanguageName(languageCode);

// Helper functions - find the version that matches the current language
const getVersionForLanguage = (poem: any) => {
  // First check if any version has the exact language code
  for (const [key, value] of Object.entries(poem.data)) {
    if (value && typeof value === 'object' && 'text' in value) {
      const version = value as any;
      const versionLang = version.language || key;
      if (versionLang.split('-')[0] === languageCode) {
        return { version, key };
      }
    }
  }
  // Fallback to canonical
  return { version: poem.data.canonical, key: 'canonical' };
};

const getTitle = (poem: any) => {
  const { version } = getVersionForLanguage(poem);
  return versionTitle(version);
};

const getAuthor = (poem: any) => {
  const { version } = getVersionForLanguage(poem);
  return version?.author || 'Unknown';
};

const getLanguage = (poem: any) => {
  const { version } = getVersionForLanguage(poem);
  return version?.language || languageCode;
};

const getVersionKey = (poem: any) => {
  const { key } = getVersionForLanguage(poem);
  return key;
};

// Sort poems by title
const sortedPoems = [...poems].sort((a, b) => 
  getTitle(a).localeCompare(getTitle(b))
);
---

<LairLayout title={`${languageName} - The dragon's lair`} showSidebar={false} searchIndex={searchIndex}>
  <style>
    .index-container {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    /* TABBED BOX */
    .tabbed-box {
      width: 100%;
      background: var(--warm-white);
      border: 1px solid var(--border);
      border-radius: 4px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      max-height: 95vh;
    }

    .tab-navbar {
      display: flex;
      border-bottom: 1px solid var(--border);
      background: var(--paper);
      flex-shrink: 0;
    }

    .tab-button {
      flex: 1;
      padding: 1rem 1.5rem;
      border: none;
      background: none;
      font-family: 'Inconsolata', monospace;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--ink-light);
      transition: all 0.2s;
      border-bottom: 3px solid transparent;
      position: relative;
      text-decoration: none;
      display: block;
      text-align: center;
    }

    .tab-button:hover {
      color: var(--ink);
      background: var(--warm-white);
    }

    .tab-button.active {
      color: var(--rust);
      background: var(--warm-white);
      border-bottom-color: var(--rust);
      font-weight: 600;
    }

    .tab-content {
      padding: 2rem;
      overflow-y: auto;
      flex: 1;
      min-height: 0;
    }

    /* POEMS LIST HEADER */
    .poems-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }

    .poems-title {
      font-family: 'IM Fell English', serif;
      font-size: 1.6rem;
      color: var(--ink);
    }

    .back-link {
      padding: 0.5rem 1rem;
      background: none;
      border: 1px solid var(--border);
      border-radius: 3px;
      font-family: 'Inconsolata', monospace;
      font-size: 0.8rem;
      color: var(--ink-light);
      transition: all 0.2s;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-decoration: none;
      display: inline-block;
    }

    .back-link:hover {
      background: var(--paper);
      border-color: var(--rust);
      color: var(--rust);
    }

    /* POEMS LIST */
    .poems-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .poem-entry {
      text-decoration: none;
      color: var(--ink);
      display: block;
      padding: 0 0 1.5rem 0;
      border-bottom: 1px solid var(--paper-dark);
      transition: all 0.2s;
    }

    .poem-entry:last-child {
      border-bottom: none;
    }

    .poem-entry:hover .poem-title {
      color: var(--rust);
    }

    .poem-title {
      font-family: 'IM Fell English', serif;
      font-size: 1.3rem;
      font-weight: 400;
      margin-bottom: 0.3rem;
      color: var(--ink);
      line-height: 1.3;
      transition: color 0.2s;
    }

    .poem-meta {
      font-size: 0.8rem;
      font-style: italic;
      color: var(--ink-light);
    }

    @media (max-width: 768px) {
      .tab-navbar {
        flex-direction: column;
      }

      .tab-button {
        border-bottom: 1px solid var(--paper-dark);
        border-left: 3px solid transparent;
      }

      .tab-button.active {
        border-bottom-color: var(--paper-dark);
        border-left-color: var(--rust);
      }

      .tab-content {
        padding: 1.5rem;
      }

      .tabbed-box {
        max-height: 90vh;
      }

      .poems-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }

      .poems-title {
        font-size: 1.3rem;
      }
    }
  </style>

  <div class="index-container">
    <div class="tabbed-box">
      <nav class="tab-navbar" id="content">
        <a href="/" class="tab-button">By Author</a>
        <a href="/title" class="tab-button">By Title</a>
        <a href="/language" class="tab-button active">By Language</a>
      </nav>

      <div class="tab-content">
        <div class="poems-header">
          <div class="poems-title">{languageName}</div>
          <a href="/language" class="back-link">← Back</a>
        </div>

        <div class="poems-list">
          {sortedPoems.map(poem => {
            const lang = getLanguage(poem);
            const scriptClass = getScriptClass(lang);
            const versionKey = getVersionKey(poem);
            return (
              <a href={`/poems/${poem.id}/${versionKey}`} class="poem-entry">
                <div class:list={['poem-title', scriptClass]} lang={lang}>{getTitle(poem)}</div>
                <div class="poem-meta">{getAuthor(poem)}</div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      document.getElementById('content')?.scrollIntoView({ block: 'start', behavior: 'instant' });
    });
  </script>
</LairLayout>