---
export interface Props {
  title?: string;
  author?: string;
  authorSlug?: string;
  translator?: string;
  language: string;
  text: string;
  rtl?: boolean;
  drama?: boolean;
}

const { title, author, authorSlug, translator, language, text, rtl = false, drama = false } = Astro.props;

interface Speech {
  speaker: string | null;
  direction: string | null;
  lines: string[];
}

// A speaker label is a line holding nothing but an all-caps name, optionally
// followed by a bracketed stage direction, ending in a period:
//   "VALENTINE."   "LUSTIGE PERSON."   "FAUST [dancing with the young witch]."
// The direction is captured separately so it does not widen the name column.
const SPEAKER = /^([\p{Lu}][\p{Lu}\p{Zs}'’\-]*?)\s*(?:\[([^\]]*)\]|\(([^)]*)\))?\.$/u;

function parseDrama(source: string): Speech[] {
  const speeches: Speech[] = [];
  let current: Speech | null = null;

  for (const line of source.replace(/\s+$/, '').split('\n')) {
    const trimmed = line.trim();
    const match = trimmed.match(SPEAKER);
    if (match) {
      const [, name, bracketed, parenthesised] = match;
      const direction = bracketed ?? parenthesised ?? null;
      current = { speaker: `${name}.`, direction, lines: [] };
      speeches.push(current);
      continue;
    }
    if (!current) {
      current = { speaker: null, direction: null, lines: [] };
      speeches.push(current);
    }
    current.lines.push(line);
  }

  for (const speech of speeches) {
    while (speech.lines.length && !speech.lines[0].trim()) speech.lines.shift();
    while (speech.lines.length && !speech.lines[speech.lines.length - 1].trim()) speech.lines.pop();
  }

  return speeches.filter((s) => s.speaker || s.lines.length);
}

const speeches = drama ? parseDrama(text) : [];
// Only use the two-column layout if parsing actually found speakers; otherwise
// fall back to the plain <pre> so a mislabelled poem still renders correctly.
const useDrama = speeches.some((s) => s.speaker !== null);
---

<article
  class="poem-display"
  lang={language}
  dir={rtl ? 'rtl' : undefined}
  transition:name="poem"
>
  {title && <h1 class="poem-title">{title}</h1>}
  {author && <p class="poem-author">{authorSlug ? <a href={`/author/${authorSlug}`}>{author}</a> : author}</p>}
  <hr class="poem-divider" />
  {useDrama ? (
    <div class="poem-drama">
      {speeches.map((speech) => (
        <Fragment>
          <div class="drama-speaker">{speech.speaker}</div>
          {/* No literal whitespace inside .drama-speech: it is pre-wrap, so any
              indentation in this template would render as part of the verse. */}
          <div class="drama-speech">{speech.direction && <span class="drama-direction">{speech.direction}</span>}{speech.lines.join('\n')}</div>
        </Fragment>
      ))}
    </div>
  ) : (
    <pre class="poem-text">{text}</pre>
  )}
  {translator && (
    <hr class="poem-divider" />
    <p class="poem-translator">translated by: {translator}</p>
  )}
</article>

<style>
  .poem-author a {
    color: inherit;
    text-decoration: none;
  }
  .poem-author a:visited {
    color: inherit;
  }
</style>
