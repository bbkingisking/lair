---
import { getCollection } from 'astro:content';
import LairLayout from '../layouts/LairLayout.astro';
import { iso6393 } from 'iso-639-3';

const allPoems = await getCollection('poems');

// Normalize language code: split by '-' and take first part
function normalizeLanguageCode(lang: string): string {
  return lang.split('-')[0];
}

// Get language name from ISO 639-3 code
function getLanguageName(code: string): string {
  const normalized = normalizeLanguageCode(code);
  const lang = iso6393.find((l: any) => l.iso6393 === normalized);
  return lang?.name || code;
}

// Get unique languages from ALL versions (canonical + translations)
const languageGroups = allPoems.reduce((acc: any, poem) => {
  // Get all keys from poem.data
  const allVersions = Object.keys(poem.data);
  
  allVersions.forEach(versionKey => {
    const version = poem.data[versionKey];
    if (version && typeof version === 'object' && 'text' in version) {
      const lang = version.language || versionKey;
      const normalizedLang = normalizeLanguageCode(lang);
      if (!acc[normalizedLang]) {
        acc[normalizedLang] = [];
      }
      // Only add if not already in array (to avoid duplicates)
      if (!acc[normalizedLang].some((p: any) => p.id === poem.id)) {
        acc[normalizedLang].push(poem);
      }
    }
  });
  
  return acc;
}, {});

// Sort languages by poem count (descending)
const uniqueLanguages = Object.keys(languageGroups).sort((a, b) =>
  languageGroups[b].length - languageGroups[a].length
);

const searchIndex = allPoems
  .filter(p => p.data.canonical?.text)
  .map(p => ({ title: p.data.canonical?.title || 'Untitled', author: p.data.canonical?.author || 'Unknown', slug: p.id, lang: 'canonical' }));
---

<LairLayout title="The dragon's lair" showSidebar={false} searchIndex={searchIndex}>
  <style>
    .index-container {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    /* TABBED BOX */
    .tabbed-box {
      width: 100%;
      background: var(--warm-white);
      border: 1px solid var(--border);
      border-radius: 4px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      max-height: 95vh;
    }

    .tab-navbar {
      display: flex;
      border-bottom: 1px solid var(--border);
      background: var(--paper);
      flex-shrink: 0;
    }

    .tab-button {
      flex: 1;
      padding: 1rem 1.5rem;
      border: none;
      background: none;
      font-family: 'Inconsolata', monospace;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--ink-light);
      transition: all 0.2s;
      border-bottom: 3px solid transparent;
      position: relative;
      text-decoration: none;
      display: block;
      text-align: center;
    }

    .tab-button:hover {
      color: var(--ink);
      background: var(--warm-white);
    }

    .tab-button.active {
      color: var(--rust);
      background: var(--warm-white);
      border-bottom-color: var(--rust);
      font-weight: 600;
    }

    .tab-content {
      padding: 2rem;
      overflow-y: auto;
      flex: 1;
      min-height: 0;
    }

    /* CATEGORIES VIEW */
    .categories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
    }

    .category-item {
      padding: 1rem 1.5rem;
      background: var(--paper);
      border: 1px solid var(--border);
      border-radius: 3px;
      transition: all 0.2s;
      text-align: center;
      text-decoration: none;
      color: var(--ink);
      display: block;
    }

    .category-item:hover {
      background: var(--warm-white);
      border-color: var(--rust);
      transform: translateY(-2px);
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .category-name {
      font-family: 'IM Fell English', serif;
      font-size: 1.1rem;
      color: var(--ink);
      margin-bottom: 0.3rem;
    }

    .category-count {
      font-family: 'Inconsolata', monospace;
      font-size: 0.75rem;
      color: var(--ink-faint);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    @media (max-width: 768px) {
      .tab-navbar {
        flex-direction: column;
      }

      .tab-button {
        border-bottom: 1px solid var(--paper-dark);
        border-left: 3px solid transparent;
      }

      .tab-button.active {
        border-bottom-color: var(--paper-dark);
        border-left-color: var(--rust);
      }

      .tab-content {
        padding: 1.5rem;
      }

      .categories-grid {
        grid-template-columns: 1fr;
      }

      .tabbed-box {
        max-height: 90vh;
      }
    }
  </style>

  <div class="index-container">
    <div class="tabbed-box" id="content">
      <nav class="tab-navbar">
        <a href="/author" class="tab-button">By Author</a>
        <a href="/title" class="tab-button">By Title</a>
        <a href="/language" class="tab-button active">By Language</a>
      </nav>

      <div class="tab-content">
        <div class="categories-grid">
          {uniqueLanguages.map(lang => (
            <a href={`/language/${encodeURIComponent(lang)}`} class="category-item">
              <div class="category-name">{getLanguageName(lang)}</div>
              <div class="category-count">{languageGroups[lang].length} {languageGroups[lang].length === 1 ? 'poem' : 'poems'}</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      document.getElementById('content')?.scrollIntoView();
    });
  </script>
</LairLayout>