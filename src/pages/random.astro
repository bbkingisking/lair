---
import { getCollection } from 'astro:content';
import LairLayout from '../layouts/LairLayout.astro';

const poems = await getCollection('poems');

// Built once, into a static page — but the pick itself happens in the
// visitor's browser on every load, so the same HTML sends a different
// person to a different poem each time. The slug list below is exactly
// the corpus as of build time; poems added later won't be reachable from
// here until the next build.
const slugs = poems.map(poem => poem.id);
---

<LairLayout title="Random poem — The dragon's lair" showSidebar={false} search>
  <div class="random-redirect">
    <p class="message">Choosing a poem at random&hellip;</p>
    <noscript>
      <p class="fallback">
        This page picks a poem with JavaScript, which appears to be off.
        <a href="/title">Browse the collection by title</a> instead.
      </p>
    </noscript>
  </div>
</LairLayout>

<script define:vars={{ slugs }}>
  function redirectToRandomPoem() {
    if (!slugs.length) return;
    const slug = slugs[Math.floor(Math.random() * slugs.length)];
    window.location.replace(`/poems/${encodeURIComponent(slug)}/canonical`);
  }
  document.addEventListener('astro:page-load', redirectToRandomPoem);
</script>

<style>
  .random-redirect {
    text-align: center;
    padding: 4rem 1rem 5rem;
  }

  .message {
    font-family: 'IM Fell English', serif;
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ink-light);
  }

  .fallback {
    margin-top: 1.5rem;
    font-family: 'Inconsolata', monospace;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .fallback a {
    color: var(--rust);
  }
</style>
